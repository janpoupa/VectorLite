{
  "productName": "VectorLite",
  "version": "0.1.0",
  "identifier": "com.vectorlite.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "VectorLite",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 500,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["svg"],
        "name": "Scalable Vector Graphics",
        "mimeType": "image/svg+xml",
        "role": "Viewer"
      },
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ]
  }
}
